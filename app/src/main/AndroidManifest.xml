<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:theme="@style/AppTheme"
        android:label="MediLembrete">

        <!-- Tela de detalhes do medicamento -->
        <activity
            android:name=".DetalheMedicamentoActivity"
            android:exported="false" />

        <!-- Histórico de medicamentos -->
        <activity
            android:name=".HistoricoActivity"
            android:exported="false" />

        <!-- Lista de medicamentos -->
        <activity
            android:name=".MeusMedicamentosActivity"
            android:exported="false" />

        <!-- Cadastro de medicamentos -->
        <activity
            android:name=".CadastroMedicamentoActivity"
            android:exported="false" />


        <!-- Tela principal do aplicativo -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>