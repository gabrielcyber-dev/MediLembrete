<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quando o campo estiver selecionado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="#F8FAFC"/>

            <stroke
                android:width="1dp"
                android:color="#2461D0"/>

            <corners android:radius="12dp"/>

            <padding
                android:left="12dp"
                android:top="0dp"
                android:right="12dp"
                android:bottom="0dp"/>

        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#F8FAFC"/>

            <stroke
                android:width="1dp"
                android:color="#D8E0EC"/>

            <corners android:radius="12dp"/>

            <padding
                android:left="12dp"
                android:top="0dp"
                android:right="12dp"
                android:bottom="0dp"/>

        </shape>
    </item>

</selector>