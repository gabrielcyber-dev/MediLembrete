<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F0F4FF">
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="#1A4FBF">
    <Button android:id="@+id/btnVoltarDetalhe" android:layout_width="44dp" android:layout_height="44dp" android:text="‹" android:textSize="25sp" android:textColor="#FFFFFF" android:backgroundTint="#553FFFFFFF"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detalhes do medicamento" android:textColor="#BFDBFE" android:textSize="13sp" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/txtNomeDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Medicamento" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/txtDosagemDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DBEAFE" android:textSize="16sp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/txtHorariosDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="16dp"/>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="20dp" android:background="#FFFFFF">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INFORMAÇÕES" android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" android:paddingTop="12dp"/>
    <TextView android:id="@+id/txtFormaDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="16sp" android:paddingTop="18dp" android:paddingBottom="14dp"/>
    <TextView android:id="@+id/txtFrequenciaDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="16sp" android:paddingTop="14dp" android:paddingBottom="14dp"/>
    <TextView android:id="@+id/txtDuracaoDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="16sp" android:paddingTop="14dp" android:paddingBottom="14dp"/>
    <TextView android:id="@+id/txtObservacoesDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#475569" android:textSize="15sp" android:paddingTop="14dp" android:paddingBottom="14dp"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#FFFFFF">
  <Button android:id="@+id/btnExcluirDetalhe" android:layout_width="match_parent" android:layout_height="54dp" android:text="Excluir medicamento" android:textAllCaps="false" android:textColor="#DC2626" android:backgroundTint="#FEE2E2"/>
 </LinearLayout>
</LinearLayout>