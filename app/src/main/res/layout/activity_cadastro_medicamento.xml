<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F3F5FF"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="18dp">
            <TextView android:id="@+id/btnVoltar" android:layout_width="42dp" android:layout_height="42dp"
                android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="#26345D"
                android:background="@drawable/bg_back_button"/>
            <TextView android:id="@+id/txtTituloCadastro" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="Novo medicamento" android:textColor="#20294A"
                android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cor de identificação" android:textColor="#35416A" android:textStyle="bold" android:textSize="16sp"/>
        <RadioGroup android:id="@+id/rgCor" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="18dp">
            <RadioButton android:id="@+id/corLaranja" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:button="@drawable/dot_orange" android:gravity="center" android:background="@android:color/transparent" android:text="" android:contentDescription="Selecionar laranja" android:checked="true"/>
            <RadioButton android:id="@+id/corRoxo" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:button="@drawable/dot_purple" android:gravity="center" android:background="@android:color/transparent" android:text="" android:contentDescription="Selecionar roxo"/>
            <RadioButton android:id="@+id/corCiano" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:button="@drawable/dot_cyan" android:gravity="center" android:background="@android:color/transparent" android:text="" android:contentDescription="Selecionar ciano"/>
            <RadioButton android:id="@+id/corVerde" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:button="@drawable/dot_lime" android:gravity="center" android:background="@android:color/transparent" android:text="" android:contentDescription="Selecionar verde"/>
            <RadioButton android:id="@+id/corLaranjaClaro" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:button="@drawable/dot_amber" android:gravity="center" android:background="@android:color/transparent" android:text="" android:contentDescription="Selecionar amarelo"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nome do medicamento *" android:textColor="#586482" android:textSize="13sp" android:textStyle="bold"/>
        <EditText android:id="@+id/etNome" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_edittext" android:paddingHorizontal="14dp" android:hint="Ex.: Losartana" android:singleLine="true" android:textColor="#26345D" android:textSize="16sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forma do medicamento *" android:textColor="#586482" android:textSize="13sp" android:textStyle="bold"/>
        <RadioGroup android:id="@+id/rgForma" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="12dp">
            <RadioButton android:id="@+id/formaComprimido" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:checked="true" android:text="Comprimido" android:textSize="15sp"/>
            <RadioButton android:id="@+id/formaCapsula" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="Cápsula" android:textSize="15sp"/>
            <RadioButton android:id="@+id/formaLiquido" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="Líquido" android:textSize="15sp"/>
            <RadioButton android:id="@+id/formaLocao" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="Loção" android:textSize="15sp"/>
            <RadioButton android:id="@+id/formaSpray" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="Spray" android:textSize="15sp"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dosagem *" android:textColor="#586482" android:textSize="13sp" android:textStyle="bold"/>
        <EditText android:id="@+id/etDosagem" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_edittext" android:paddingHorizontal="14dp" android:hint="Ex.: 250 mg, 10 ml, 5%" android:singleLine="true" android:textColor="#26345D" android:textSize="16sp"/>

        <TextView android:id="@+id/tvUnidadeQuantidade" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quantidade por dose (comprimidos) *" android:textColor="#586482" android:textSize="13sp" android:textStyle="bold"/>
        <EditText android:id="@+id/etQuantidade" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_edittext" android:paddingHorizontal="14dp" android:hint="Ex.: 1" android:inputType="number" android:singleLine="true" android:textColor="#26345D" android:textSize="16sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Horário inicial" android:textColor="#35416A" android:textStyle="bold" android:textSize="16sp"/>
        <TextView android:id="@+id/tvHorarioInicial" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:drawableEnd="@drawable/ic_clock" android:drawablePadding="10dp" android:background="@drawable/bg_edittext" android:text="08:00" android:textColor="#26345D" android:textSize="16sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frequência" android:textColor="#35416A" android:textStyle="bold" android:textSize="16sp"/>
        <RadioGroup android:id="@+id/rgFrequencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp">
            <RadioButton android:id="@+id/freq6" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="A cada 6 horas" android:textSize="15sp"/>
            <RadioButton android:id="@+id/freq8" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="A cada 8 horas" android:textSize="15sp"/>
            <RadioButton android:id="@+id/freq12" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:text="A cada 12 horas" android:textSize="15sp"/>
            <RadioButton android:id="@+id/freq24" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="7dp" android:paddingStart="14dp" android:background="@drawable/bg_choice_card" android:buttonTint="#1A4FBF" android:checked="true" android:text="1 vez ao dia" android:textSize="15sp"/>
        </RadioGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginTop="5dp" android:layout_marginBottom="16dp" android:background="#EEF3FF">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Horários gerados:" android:textColor="#64748B" android:textSize="13sp" android:textStyle="bold"/>
            <LinearLayout android:id="@+id/tvPreviaHorarios" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duração do tratamento" android:textColor="#35416A" android:textStyle="bold" android:textSize="16sp"/>
        <EditText android:id="@+id/etDuracaoDias" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:layout_marginBottom="5dp" android:background="@drawable/bg_edittext" android:paddingHorizontal="14dp" android:hint="Quantidade de dias" android:inputType="number" android:singleLine="true" android:textColor="#26345D" android:textSize="16sp"/>
        <CheckBox android:id="@+id/cbContinuo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duração contínua" android:textColor="#35416A" android:textSize="15sp" android:layout_marginBottom="14dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Observações" android:textColor="#35416A" android:textStyle="bold" android:textSize="16sp"/>
        <EditText android:id="@+id/etObservacoes" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="7dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_edittext" android:gravity="top|start" android:padding="14dp" android:hint="Ex.: Tomar com água, em jejum..." android:inputType="textCapSentences|textMultiLine" android:textColor="#26345D" android:textSize="16sp"/>

        <Button android:id="@+id/btnSalvar" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_botao_arredondado" android:text="✓  Salvar medicamento" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
