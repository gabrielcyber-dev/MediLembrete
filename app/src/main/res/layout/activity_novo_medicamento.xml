<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Novo medicamento"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNomeMedicamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do medicamento"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtDosagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dosagem"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade por dose"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Horário inicial"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtHorarioInicial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: 08:00"
            android:inputType="time" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Intervalo"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerIntervalo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Duração do tratamento"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDuracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade de dias"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/chkDuracaoIndefinida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duração indefinida" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Salvar medicamento" />

    </LinearLayout>

</ScrollView>